# 7-Phase Agentic Workflow Governance & Safety Specifications
# Layer 0 (DROS) + Layer 1 (BTC) + Layer 2 (Oxford SHARS) + Layer 3 (System 1) + Layer 4 (Invariants Sentinel)

@guards {
  # === LAYER 0: DROS VajraClaw Deterministic Runtime Safety ===
  dros-vajraclaw: {
    latency: "<1μs"
    mode: "deterministic-ast-fuse"
    enforcement: "hard-circuit-breaker"
    identity: "W3C did:key cryptographic pass (RFC-010)"
    audit: "SHA-256 Merkle tree chain"
    blockedPatterns: [
      "rm -rf /",
      "eval(base64_decode(...))",
      "curl | bash",
      "chmod 777",
      "git push --force origin main"
    ]
  }

  # === LAYER 1: BTC Thermodynamic Trust Governor ===
  btc-trust-governor: {
    mode: "thermodynamic-credit"
    formula: "T = PPV * exp(-sigma * T_comp)"
    thresholdTheta: 0.65
    parameters: {
      ppvBase: 0.95
      decaySigma: 0.15
      maxComplexityTemp: 2.0
    }
    actionOnBreach: "downgrade-to-sandboxed-read-only"
  }

  # === LAYER 2: Oxford/OATML SHARS Hallucination Rejection Sampling ===
  oxford-shars: {
    mode: "segment-wise-rejection-sampling"
    claimDecomposition: "atomic-propositional-split"
    verification: "cross-entropy-uncertainty-filter"
    dynamicDeltaRewriting: true
    followingConstraintGeneration: true
    rejectionThreshold: 0.70
  }

  # === LAYER 3: System 1 Decision Gate ===
  system-one-gate: {
    latency: "<50ms"
    tokenOutput: 0
    mode: "pluggable-system-1-decision"
    protocol: "/v1/systemone"
    referenceModel: "laya:multilingual"
    primitives: ["Noul (Zero Seams)", "Choice (Ponytail Tier)", "Score (Bloat Index)"]
    actionOnBlock: "block-and-demand-refactor"
  }

  # === LAYER 4: Invariants Sentinel & Loop Gate ===
  invariants-sentinel: {
    mode: "mechanical-gate-and-graph"
    config: "gate.yaml & invariants.yaml"
    enforcement: "denylist-hard-block"
    maxFileEdits: 8
    driftMonitoring: "ast-call-graph-impact"
  }
}
